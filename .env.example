PORT=3001
NODE_ENV=production
DATA_DIR=/app/data
APP_URL=http://localhost:3001
JWT_SECRET=local-dev-secret-with-more-than-32-chars

# WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=

# Optional PostgreSQL / Supabase
DATABASE_URL=
PGSSL=false

# Optional Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Optional frontend API base URL for separated frontend/backend deploys.
# Leave empty when the same Node container serves both the frontend and /api.
VITE_API_BASE_URL=
